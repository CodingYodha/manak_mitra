# ==========================================================
# Manak Mitra - Environment Configuration Template
# Copy this file to .env and provide your API credentials
# ==========================================================

# Azure OpenAI Configuration (Primary LLM Provider)
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Groq Configuration (Fast Fallback LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Exa Web Search (Official Gazette & BIS standard live references)
EXA_API_KEY=your_exa_api_key_here
EXA_NUM_RESULTS=3

# Local Ollama Configuration (Offline Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
